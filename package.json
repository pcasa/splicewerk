{
  "name": "splicewerk",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "bin": {
    "splicewerk": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "produce": "tsx src/cli/index.ts",
    "lint": "ruff check scripts/ && tsc --noEmit",
    "format": "ruff format scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "logo-reveal": "tsx scripts/logo-reveal.ts",
    "logo-reveal:force": "tsx scripts/logo-reveal.ts --force",
    "logo-reveal:new-fx": "tsx scripts/logo-reveal.ts --force-runway",
    "logo-reveal:baseline": "tsx scripts/logo-reveal.ts --force-runway --baseline-prompt",
    "nemotron": "tsx scripts/ask-nemotron.ts"
  },
  "vitest": {
    "include": [
      "src/**/*.test.ts"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.2",
  "dependencies": {
    "@runwayml/sdk": "^3.16.0",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "fluent-ffmpeg": "^2.1.3",
    "inngest": "^4.0.4",
    "sharp": "^0.34.5",
    "shotstack-sdk": "^0.2.9",
    "splicewerk": "link:",
    "typescript": "^5.9.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.0"
  }
}
